# KasaSpeech Gradio Spaces and optional Hugging Face Inference Endpoints.
# These values are server-side only. Never use NEXT_PUBLIC_ for secrets.
KASASPEECH_ASR_ENDPOINT_URL=
HF_TOKEN=

# Optional Hugging Face endpoints already supported by kasaspeech_independent.
# The Next.js workspaces use the KasaSpeech translation endpoint for English↔Twi
# and the English/Twi speech endpoints when no LINGUA_* provider is set.
KASASPEECH_TRANSLATION_ENDPOINT_URL=
KASASPEECH_TTS_EN_ENDPOINT_URL=
KASASPEECH_TTS_TW_ENDPOINT_URL=

# Optional language-identification service.
# Accepts multipart/form-data with "audio"; returns { "language": "en", "confidence": 0.9 }.
LINGUA_DETECTION_API_URL=
LINGUA_DETECTION_API_KEY=

# Translation provider (OpenAI-compatible chat completions by default; or FORMAT=rest).
# For OpenAI-compatible endpoints, URL must be the full chat-completions endpoint.
# REST receives { task, model, text, sourceLanguage, targetLanguage, voice }.
LINGUA_TRANSLATION_API_URL=
LINGUA_TRANSLATION_API_KEY=
LINGUA_TRANSLATION_MODEL=
LINGUA_TRANSLATION_FORMAT=
LINGUA_TRANSLATION_RESPONSE_FIELD=text

# AI assistant provider (OpenAI-compatible chat completions by default; or FORMAT=rest).
LINGUA_ASSISTANT_API_URL=
LINGUA_ASSISTANT_API_KEY=
LINGUA_ASSISTANT_MODEL=
LINGUA_ASSISTANT_FORMAT=
LINGUA_ASSISTANT_RESPONSE_FIELD=text

# TTS provider returns audio/* bytes (OpenAI-compatible speech endpoint by default; or FORMAT=rest).
LINGUA_TTS_API_URL=
LINGUA_TTS_API_KEY=
LINGUA_TTS_MODEL=
LINGUA_TTS_FORMAT=
